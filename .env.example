# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=votre_cle_google_ai_studio
GEMINI_MODEL=gemini-3.8-flash
# Modèles essayés si le principal est surchargé (séparés par des virgules)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest
# Niveau de réflexion des modèles Gemini 3 : minimal, low, medium, high (vide = défaut)
GEMINI_THINKING_LEVEL=low

# --- TTS : XTTS v2 wolof (GalsenAI) ---
# Jeton Hugging Face (lecture) : sert seulement à download_xtts.py, modèle restreint
HF_TOKEN=hf_votre_jeton
XTTS_CODE_DIR=vendor/Wolof-TTS/notebooks/Models/xTTS v2
XTTS_CHECKPOINT_DIR=models/galsenai-xtts-wo-checkpoints
XTTS_MODEL_FILE=best_model_89250.pth
# Voix de référence (vide = anta_sample.wav fourni avec le checkpoint)
XTTS_REFERENCE_WAV=
# cuda, cpu, ou vide pour détection automatique
XTTS_DEVICE=
XTTS_SPEED=1.06
# Charger le modèle au démarrage du serveur (en arrière-plan)
XTTS_PRELOAD=true

# --- RAG ---
DOCUMENTS_DIR=data/documents
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
